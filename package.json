{
  "name": "pixi-scene-inspector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./overlay": {
      "types": "./build/overlay.d.ts",
      "default": "./build/overlay.js"
    }
  },
  "scripts": {
    "dev": "node build.js --watch",
    "build": "node build.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,svelte}\" \"demo/**/*.{ts,svelte}\"",
    "lint:fix": "eslint \"src/**/*.{ts,svelte}\" \"demo/**/*.{ts,svelte}\" --fix",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "preview-ui": "vite --config demo/vite.config.ts --open /preview.html"
  },
  "devDependencies": {
    "@pixi/eslint-config": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "esbuild": "^0.25.10",
    "esbuild-svelte": "^0.9.3",
    "eslint": "^9.35.0",
    "eslint-plugin-jsdoc": "^50.6.3",
    "eslint-plugin-no-mixed-operators": "^1.1.1",
    "eslint-plugin-svelte": "^2.46.1",
    "pixi.js": "^8.22.0",
    "svelte": "^5.39.11",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.10"
  }
}
