{
  "name": "pixi-scene-inspector",
  "version": "1.4.0",
  "description": "Visual inspector for the PixiJS scene tree and node properties (Chrome extension + in-page npm package)",
  "type": "module",
  "license": "MIT",
  "author": "Enea Entertainment",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EneaEntertainment/pixi-scene-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/EneaEntertainment/pixi-scene-inspector/issues"
  },
  "homepage": "https://eneaentertainment.github.io/pixi-scene-inspector/",
  "keywords": [
    "pixi",
    "pixijs",
    "inspector",
    "devtools",
    "scene-graph"
  ],
  "files": [
    "build/index.js",
    "build/index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "types": "./build/index.d.ts",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "scripts": {
    "dev": "node build.js --watch",
    "build": "node build.js",
    "prepublishOnly": "npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,svelte}\" \"demo/**/*.{ts,svelte}\" \"demo-3d/**/*.{ts,svelte}\"",
    "lint:fix": "eslint \"src/**/*.{ts,svelte}\" \"demo/**/*.{ts,svelte}\" \"demo-3d/**/*.{ts,svelte}\" --fix",
    "demo": "npm run build && vite --config demo/vite.config.ts",
    "demo:3d": "npm run build && vite --config demo-3d/vite.config.ts",
    "demo:build": "npm run build && vite build --config demo/vite.config.ts && vite build --config demo-3d/vite.config.ts"
  },
  "devDependencies": {
    "@esotericsoftware/spine-pixi-v8": "~4.3.0",
    "@pixi/3d": "^0.1.0",
    "@pixi/eslint-config": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.10",
    "esbuild-svelte": "^0.9.3",
    "eslint": "^9.35.0",
    "eslint-plugin-jsdoc": "^50.6.3",
    "eslint-plugin-no-mixed-operators": "^1.1.1",
    "eslint-plugin-svelte": "^2.46.1",
    "pixi.js": "^8.23.0",
    "svelte": "^5.39.11",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.10"
  }
}
